        "tier": 3,
        "mode": "daemon",
        "type": "climate-control",
        "compact": true,
        "connectionType": "cloud",
        "dataSource": "push",
        "adminUI": {
            "config": "json"
        },
        "dependencies": [
            {
                "js-controller": ">=6.0.11"
            }
        ],
        "globalDependencies": [
            {
                "admin": ">=7.0.23"
            }
        ]
    },
    "encryptedNative": [
        "password"
    ],
    "protectedNative": [
        "password"
    ],
    "native": {
        "email": "",
        "password": "",
        "region": "eu",
        "refreshInterval": 300,
        "useWebSocket": true
    },
    "objects": [],
    "instanceObjects": [
        {
            "_id": "info",
            "type": "channel",
            "common": {
                "name": "Information"
            },
            "native": {}
        },
        {
            "_id": "info.connection",
            "type": "state",
            "common": {
                "role": "indicator.connected",
                "name": "Connected to Dreo cloud",
                "type": "boolean",
                "read": true,
                "write": false,
                "def": false
            },
            "native": {}
        },
        {
            "_id": "commands",
            "type": "channel",
            "common": {
                "name": "Commands"
            },
            "native": {}
        },
        {
            "_id": "commands.manualRefresh",
            "type": "state",
            "common": {
                "role": "button",
                "name": "Refresh all devices",
                "type": "boolean",
                "read": false,
                "write": true,
                "def": false
            },
            "native": {}
        }
    ]
}
